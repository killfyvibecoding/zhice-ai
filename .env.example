# ===== App =====
APP_NAME=职策AI

# ===== Auth =====
AUTH_ENABLED=false
AUTH_SECRET=your-auth-secret-key-change-me

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# WeChat Mini Program login
WECHAT_MINIPROGRAM_APP_ID=your-mini-program-app-id
WECHAT_MINIPROGRAM_APP_SECRET=your-mini-program-app-secret
WECHAT_SESSION_SECRET=your-wechat-session-secret
# Development only; leave empty in production.
WECHAT_MINIPROGRAM_DEV_OPENID=
# Development only: keep the local mini program test account supplied with
# credits without decrementing its stored balance. Must be false/unset in production.
MINIPROGRAM_DEBUG_CREDITS=false

# ===== Database =====
DB_TYPE=sqlite

# PostgreSQL (when DB_TYPE=postgresql)
DATABASE_URL=postgresql://user:password@localhost:5432/zhice_ai

# SQLite (when DB_TYPE=sqlite)
SQLITE_PATH=./data/jade.db

# ===== i18n =====
DEFAULT_LOCALE=zh

# ===== Server-side AI for Mini Program =====
# These values stay on the Zhice AI server and are never sent to clients.
AI_PROVIDER=openai
AI_API_KEY=your-server-side-ai-api-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o

# ===== Server-side image generation for Mini Program =====
# Never put these values in the Mini Program or send them from the client.
IMAGE_API_KEY=your-server-side-image-api-key
IMAGE_BASE_URL=https://your-image-provider.example/v1
IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_API_FORMAT=openai
